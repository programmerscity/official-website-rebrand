# Turn on the rewrite engine
RewriteEngine On

# =============================================
# 1. Force HTTPS (except on localhost)
# =============================================
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# =============================================
# 2. Remove trailing slashes (SEO friendly)
# =============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# =============================================
# 3. Service detail pages – clean URL: /service/software-development
#    Internally maps to public/service-details.php?slug=software-development
# =============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^service/([a-zA-Z0-9-]+)$ public/service-details.php?slug=$1 [L,QSA]

# =============================================
# 4. Generic page routing (existing rules)
#    Maps /page to public/page.php, and /subdir/page to public/subdir/page.php
# =============================================

# Handle root-level pages (e.g., /about -> public/about.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^([^/.]+)$ public/$1.php [L]

# Handle root-level pages with trailing slash
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^([^/.]+)/$ public/$1.php [L]

# Handle subdirectory pages (e.g., /admin/dashboard -> public/admin/dashboard.php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-l
RewriteRule ^([^/]+)/([^/.]+)$ public/$1/$2.php [L]

# =============================================
# 5. Redirect direct access to /public/page.php or /page.php to clean URL
#    (Prevents duplicate content and keeps URLs clean)
# =============================================

# Redirect /public/page.php to /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/public/([^.\s]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# Redirect /page.php to /page
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.\s]+)\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# =============================================
# 6. Default index page and security settings
# =============================================
DirectoryIndex public/index.php
Options -Indexes