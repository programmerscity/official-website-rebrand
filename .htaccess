# Turn on the rewrite engine
RewriteEngine On

# =============================================
# 1. Force HTTPS (except on localhost)
# =============================================
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# =============================================
# 2. Remove trailing slashes (SEO friendly)
#    Only for non-existent directories and files
# =============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$ [NC]
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# =============================================
# 3. Clean URLs for Services
#    /service/slug -> public/service-details.php?slug=slug
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^service/([a-zA-Z0-9-]+)$ public/service-details.php?slug=$1 [L,QSA]

# =============================================
# 4. Clean URLs for Projects
#    /project/slug -> public/project-details.php?slug=slug
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^project/([a-zA-Z0-9-]+)$ public/project-details.php?slug=$1 [L,QSA]

# =============================================
# 5. Generic Page Routing
#    /page -> public/page.php
#    /subdir/page -> public/subdir/page.php
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ public/$1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/([^/.]+)$ public/$1/$2.php [L]

# =============================================
# 6. Redirect .php URLs to clean URLs (SEO)
#    Prevents duplicate content
# =============================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L,NE]

# =============================================
# 7. Default index page
# =============================================
DirectoryIndex public/index.php

# =============================================
# 8. Security: Prevent directory listing
# =============================================
Options -Indexes