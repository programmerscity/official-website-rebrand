# Turn on the rewrite engine
RewriteEngine On

# =============================================
# 1. EXCLUDE ACTUAL FILES FROM REWRITING
#    This fixes sitemap.xml and robots.txt 404 errors
# =============================================
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# =============================================
# 2. Force HTTPS (except on localhost)
# =============================================
RewriteCond %{HTTP_HOST} !^localhost$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# =============================================
# 3. Remove trailing slashes (SEO friendly)
# =============================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} /$ [NC]
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# =============================================
# 4. Clean URLs for Services
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^service/([a-zA-Z0-9-]+)$ public/service-details.php?slug=$1 [L,QSA]

# =============================================
# 5. Clean URLs for Projects
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^project/([a-zA-Z0-9-]+)$ public/project-details.php?slug=$1 [L,QSA]

# =============================================
# 6. Generic Page Routing
# =============================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ public/$1.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/]+)/([^/.]+)$ public/$1/$2.php [L]

# =============================================
# 7. Redirect .php URLs to clean URLs
# =============================================
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L,NE]

# =============================================
# 8. Default index page
# =============================================
DirectoryIndex public/index.php

# =============================================
# EXCLUDE contact-send.php FROM REWRITING
# =============================================
RewriteRule ^contact-send\.php$ - [L]

# =============================================
# WHATSAPP WEBHOOK - Allow direct access
# =============================================
RewriteRule ^whatsapp-webhook$ public/whatsapp-webhook.php [L]

# =============================================
# 9. Security: Prevent directory listing
# =============================================
Options -Indexes